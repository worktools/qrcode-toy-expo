{
  "name": "qrcode-toy-expo",
  "version": "1.0.0",
  "main": "./main.js",
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "compile": "calcit",
    "test": "yarn compile && node --test scripts/hooks.test.mjs",
    "watch": "calcit -w",
    "check": "calcit --check-only --all-defs && calcit fix --workflow strict --verify",
    "build": "yarn compile && expo export --platform android --max-workers 2 --output-dir dist/android && expo export --platform ios --max-workers 2 --output-dir dist/ios",
    "start": "yarn compile && expo start",
    "android": "yarn compile && expo start --android",
    "ios": "yarn compile && expo start --ios",
    "web": "yarn compile && expo start --web"
  },
  "dependencies": {
    "@calcit/procs": "0.30.1",
    "expo": "~49.0.13",
    "expo-barcode-scanner": "~12.5.3",
    "expo-image-picker": "~14.3.2",
    "expo-status-bar": "~1.6.0",
    "react": "18.2.0",
    "react-native": "0.72.10",
    "react-native-qrcode-svg": "^6.2.0",
    "react-native-svg": "13.9.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/plugin-syntax-import-attributes": "7.27.1",
    "babel-preset-expo": "~9.5.2",
    "react-test-renderer": "18.2.0"
  },
  "private": true
}
